<Window x:Class="CalendarApp.Views.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:vm="clr-namespace:CalendarApp.ViewModels"
        xmlns:views="clr-namespace:CalendarApp.Views"
        Icon="pack://application:,,,/Assets/app.ico"
        Title="日程桌面"
        Width="340" Height="500"
        MinWidth="240" MinHeight="280"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ResizeMode="CanResize"
        ShowInTaskbar="False"
        ShowActivated="False">
    <WindowChrome.WindowChrome>
        <WindowChrome CaptionHeight="0" ResizeBorderThickness="8"
                      GlassFrameThickness="0" UseAeroCaptionButtons="False"
                      CornerRadius="0"/>
    </WindowChrome.WindowChrome>

    <Window.Resources>
        <!-- 玻璃面板内所有滚动条统一用细半透明样式（日历/事项视图） -->
        <Style TargetType="ScrollBar" BasedOn="{StaticResource ThinGlassScrollBar}"/>

        <!-- 日程条目模板（日历选中日 / 事项列表共用） -->
        <DataTemplate x:Key="EventItemTemplate" DataType="{x:Type vm:ScheduleEventItem}">
            <Border Margin="0,4" Padding="12,9" CornerRadius="9"
                    Background="#1FFFFFFF"
                    BorderBrush="#33FFFFFF" BorderThickness="1">
                <DockPanel>
                    <TextBlock Text="{Binding TimeText}"
                               DockPanel.Dock="Left"
                               MinWidth="48" FontSize="12"
                               Foreground="#A8E6CF" />
                    <StackPanel>
                        <TextBlock Text="{Binding Title}"
                                   FontSize="13" Foreground="#F8FFFFFF"
                                   TextTrimming="CharacterEllipsis" />
                        <TextBlock Text="{Binding LocationText}"
                                   Visibility="{Binding HasLocation,
                                        Converter={StaticResource BoolToVis}}"
                                   FontSize="11" Foreground="#8CFFFFFF" />
                        <TextBlock Text="{Binding MetaText}"
                                   FontSize="10" Foreground="#8CFFFFFF"
                                   Opacity="0.75" />
                    </StackPanel>
                </DockPanel>
            </Border>
        </DataTemplate>

        <!-- 事项列表条目模板：左绿/红日期两行(居中)，中标题+两行内容预览，
             右标签 chip + 编辑按钮；右键菜单/点击展开 -->
        <DataTemplate x:Key="ItemListTemplate" DataType="{x:Type vm:ScheduleEventItem}">
            <StackPanel Margin="0,4">
                <Border Padding="12,4,8,5" CornerRadius="9"
                        Background="#1FFFFFFF"
                        BorderBrush="#33FFFFFF" BorderThickness="1"
                        MouseLeftButtonDown="OnItemBarPressed"
                        Cursor="Hand">
                    <Border.ContextMenu>
                        <ContextMenu>
                            <MenuItem Header="设为长期事项" Click="OnMarkLongTerm" />
                            <MenuItem Header="设为已完成" Click="OnMarkCompleted" />
                            <Separator/>
                            <MenuItem Header="删除" Click="OnDeleteItem" />
                        </ContextMenu>
                    </Border.ContextMenu>
                    <DockPanel>
                        <StackPanel DockPanel.Dock="Left" Margin="0,0,12,0"
                                    VerticalAlignment="Center">
                            <TextBlock Text="{Binding StartDateText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#4CAF50" />
                            <TextBlock Text="{Binding EndDateText}"
                                       FontSize="13" FontWeight="SemiBold"
                                       Foreground="#EF5350" Margin="0,3,0,0"/>
                        </StackPanel>
                        <StackPanel DockPanel.Dock="Right" Margin="8,0,0,0"
                                    VerticalAlignment="Top">
                            <Border Background="{Binding TagBackground}"
                                    CornerRadius="4" Padding="6,2"
                                    HorizontalAlignment="Right"
                                    Visibility="{Binding HasTag,
                                        Converter={StaticResource BoolToVis}}">
                                <TextBlock Text="{Binding TagText}"
                                           FontSize="9" Foreground="White" />
                            </Border>
                            <Button Width="24" Height="24" Padding="0"
                                    HorizontalAlignment="Right"
                                    Background="Transparent" BorderThickness="0"
                                    Cursor="Hand" Click="OnItemEditClicked"
                                    ToolTip="编辑"
                                    Style="{StaticResource GlassButton}">
                                <Path Width="14" Height="14" Stretch="Uniform" Fill="White">
                                    <Path.Data>
                                        <PathGeometry Figures="M20.71,7.04C21.1,6.65 21.1,6 20.71,5.63L18.37,3.29C18,2.9 17.35,2.9 16.96,3.29L15.12,5.12L18.87,8.87L20.71,7.04M3,17.25V21H6.75L17.81,9.93L14.06,6.18L3,17.25Z" />
                                    </Path.Data>
                                </Path>
                            </Button>
                        </StackPanel>
                        <StackPanel VerticalAlignment="Top">
                            <TextBlock Text="{Binding Title}"
                                       FontSize="13" Foreground="#F8FFFFFF"
                                       TextTrimming="CharacterEllipsis" />
                            <TextBlock Text="{Binding ContentPreview}"
                                       FontSize="10" Foreground="#8CFFFFFF"
                                       Opacity="0.75"
                                       TextWrapping="Wrap" MaxHeight="28"
                                       TextTrimming="CharacterEllipsis"
                                       Visibility="{Binding HasContent,
                                           Converter={StaticResource BoolToVis}}" />
                        </StackPanel>
                    </DockPanel>
                </Border>
                <Border Background="#12FFFFFF" BorderBrush="#26FFFFFF" BorderThickness="1"
                        CornerRadius="9" Padding="12,8" Margin="0,2,0,0"
                        Visibility="{Binding IsExpanded,
                            Converter={StaticResource BoolToVis}}">
                    <TextBlock Text="{Binding DetailText}" FontSize="11" Foreground="#CCFFFFFF"
                               TextWrapping="Wrap" />
                </Border>
            </StackPanel>
        </DataTemplate>
    </Window.Resources>


    <!-- 玻璃面板主体：Rainmeter 风格 DwmEnableBlurBehindWindow 实时模糊
         （WS_EX_LAYERED 分层窗口 + DWM_BB_BLURREGION）。面板色调
         （PanelBackground）盖在模糊之上，本地与 RDP 均不产生黑矩形。 -->
    <Border Margin="10" CornerRadius="16"
            Background="{Binding PanelBackground}"
            BorderBrush="#66FFFFFF"
            BorderThickness="1">
        <DockPanel>

            <!-- Title bar: date on the left (draggable), calendar/tasks switcher dead-center, gear on the right -->
            <Border DockPanel.Dock="Top" Padding="18,14,12,6"
                    Background="Transparent"
                    MouseLeftButtonDown="OnTitleBarPressed"
                    Cursor="SizeAll">
                <!-- 单单元格叠放：日期左、分段按钮绝对居中、齿轮右，保证按钮中心线=窗口中心线 -->
                <Grid>
                    <!-- 左上角日期两行（阳历 + 农历）+ 回到今天按钮 -->
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Left" VerticalAlignment="Center">
                        <StackPanel MaxWidth="100" Margin="0,0,6,0">
                            <TextBlock Text="{Binding TodayText}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="10" Foreground="#B3FFFFFF" />
                            <TextBlock Text="{Binding TodayLunarText}"
                                       HorizontalAlignment="Center"
                                       TextTrimming="CharacterEllipsis"
                                       FontSize="10" Foreground="#B3FFFFFF" />
                        </StackPanel>
                        <!-- ↩ 回到今天：仅当选中日非今天或显示月非本月时可见 -->
                        <Button Style="{StaticResource backBtn}" Width="22" Height="22" Padding="0"
                                Visibility="{Binding ShowBackToToday,
                                    Converter={StaticResource BoolToVis}}"
                                Command="{Binding GoToTodayCommand}"
                                ToolTip="回到今天"
                                VerticalAlignment="Center">
                            <TextBlock Text="↩" FontSize="14" Foreground="White"
                                       HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Button>
                    </StackPanel>

                    <!-- 圆角分段按钮：左日历 / 右事项（HorizontalAlignment=Center 相对整个顶栏居中） -->
                    <Border CornerRadius="12"
                            Background="#1FFFFFFF"
                            BorderBrush="#44FFFFFF" BorderThickness="1"
                            HorizontalAlignment="Center" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="日历" Style="{StaticResource segBtn}"
                                    Height="24" MinWidth="46" Padding="0"
                                    Background="{Binding CalendarButtonBrush}"
                                    Foreground="#E6FFFFFF" FontSize="11"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    views:ButtonRoundness.CornerRadius="10,0,0,10"
                                    BorderThickness="0"
                                    Command="{Binding ShowCalendarCommand}" />
                            <Button Grid.Column="1" Content="事项" Style="{StaticResource segBtn}"
                                    Height="24" MinWidth="46" Padding="0"
                                    Background="{Binding TaskButtonBrush}"
                                    Foreground="#E6FFFFFF" FontSize="11"
                                    HorizontalContentAlignment="Center"
                                    VerticalContentAlignment="Center"
                                    views:ButtonRoundness.CornerRadius="0,10,10,0"
                                    BorderThickness="0"
                                    Command="{Binding ShowTasksCommand}" />
                        </Grid>
                    </Border>

                    <Button HorizontalAlignment="Right" VerticalAlignment="Center"
                            Width="30" Height="30" Padding="0"
                            Background="Transparent" BorderThickness="0"
                            Style="{StaticResource GlassButton}"
                            Command="{Binding OpenSettingsCommand}"
                            ToolTip="设置">
                        <!-- 齿轮图标：标准 24x24 Material cog，EvenOdd 镂空中心孔 -->
                        <Path Width="18" Height="18" Stretch="Uniform" Fill="White">
                            <Path.Data>
                                <PathGeometry FillRule="EvenOdd"
                                              Figures="M12,15.5A3.5,3.5 0 0,1 8.5,12A3.5,3.5 0 0,1 12,8.5A3.5,3.5 0 0,1 15.5,12A3.5,3.5 0 0,1 12,15.5M19.43,12.97C19.47,12.65 19.5,12.33 19.5,12C19.5,11.67 19.47,11.34 19.43,11.02L21.54,9.37C21.73,9.22 21.78,8.95 21.66,8.73L19.66,5.27C19.54,5.05 19.27,4.96 19.05,5.05L16.56,6.05C16.04,5.66 15.5,5.32 14.87,5.07L14.5,2.42C14.46,2.18 14.25,2 14,2H10C9.75,2 9.54,2.18 9.5,2.42L9.13,5.07C8.5,5.32 7.96,5.66 7.44,6.05L4.95,5.05C4.73,4.96 4.46,5.05 4.34,5.27L2.34,8.73C2.21,8.95 2.27,9.22 2.46,9.37L4.57,11.02C4.53,11.34 4.5,11.67 4.5,12C4.5,12.33 4.53,12.65 4.57,12.97L2.46,14.63C2.27,14.78 2.21,15.05 2.34,15.27L4.34,18.73C4.46,18.95 4.73,19.04 4.95,18.95L7.44,17.94C7.96,18.34 8.5,18.68 9.13,18.93L9.5,21.58C9.54,21.82 9.75,22 10,22H14C14.25,22 14.46,21.82 14.5,21.58L14.87,18.93C15.5,18.67 16.04,18.34 16.56,17.94L19.05,18.95C19.27,19.04 19.54,18.95 19.66,18.73L21.66,15.27C21.78,15.05 21.73,14.78 21.54,14.63L19.43,12.97Z" />
                            </Path.Data>
                        </Path>
                    </Button>
                </Grid>
            </Border>


            <!-- Content area: calendar view or tasks view -->
            <Grid>

                <!-- 玻璃风格月历 -->
                <ScrollViewer Visibility="{Binding IsCalendarView,
                                    Converter={StaticResource BoolToVis}}"
                              Margin="18,10,18,10"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <!-- 月份导航 -->
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="Auto"/>
                            </Grid.ColumnDefinitions>
                            <Button Grid.Column="0" Content="‹" Style="{StaticResource navBtn}"
                                    Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#D9FFFFFF" FontSize="14"
                                    Command="{Binding PrevMonthCommand}" />
                            <!-- 月份标题：点击弹出日期跳转小窗 -->
                            <Border x:Name="MonthTitleBorder" Grid.Column="1"
                                    Background="Transparent" Cursor="Hand"
                                    MouseLeftButtonDown="OnMonthTitlePressed"
                                    ToolTip="点击输入日期跳转">
                                <TextBlock Text="{Binding CalendarTitle}"
                                           HorizontalAlignment="Center" VerticalAlignment="Center"
                                           FontSize="13" FontWeight="SemiBold" Foreground="#E6FFFFFF"
                                           Margin="8,0" />
                            </Border>
                            <Button Grid.Column="2" Content="›" Style="{StaticResource navBtn}"
                                    Width="28" Height="28" Padding="0"
                                    Background="Transparent" BorderThickness="0"
                                    Foreground="#D9FFFFFF" FontSize="14"
                                    Command="{Binding NextMonthCommand}" />
                        </Grid>

                        <!-- 星期表头（每个子元素显式 Grid.Column，防叠位） -->
                        <Grid Margin="0,8,0,4">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/><ColumnDefinition Width="*"/><ColumnDefinition Width="*"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="日" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                            <TextBlock Grid.Column="1" Text="一" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                            <TextBlock Grid.Column="2" Text="二" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                            <TextBlock Grid.Column="3" Text="三" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                            <TextBlock Grid.Column="4" Text="四" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                            <TextBlock Grid.Column="5" Text="五" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                            <TextBlock Grid.Column="6" Text="六" HorizontalAlignment="Center" FontSize="11" Foreground="#99FFFFFF" />
                        </Grid>

                        <!-- 日期格子（6x7，含前后月补位） -->
                        <ItemsControl ItemsSource="{Binding CalendarDays}">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate>
                                    <UniformGrid Columns="7" />
                                </ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate DataType="{x:Type vm:CalendarDayCell}">
                                    <Border Margin="1.5" Height="44" CornerRadius="7"
                                            Background="{Binding Background}"
                                            Opacity="{Binding CellOpacity}"
                                            MouseLeftButtonDown="OnDayCellPressed"
                                            Cursor="Hand">
                                        <StackPanel VerticalAlignment="Center">
                                            <TextBlock Text="{Binding DayText}" FontSize="12"
                                                       Foreground="{Binding Foreground}"
                                                       HorizontalAlignment="Center" />
                                            <TextBlock Text="{Binding LunarText}" FontSize="9"
                                                       Foreground="#8CFFFFFF"
                                                       HorizontalAlignment="Center" Margin="0,1,0,0"/>
                                            <Ellipse Width="3" Height="3" Fill="#A8E6CF"
                                                     Visibility="{Binding HasEvents,
                                                         Converter={StaticResource BoolToVis}}"
                                                     HorizontalAlignment="Center" />
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>

                        <!-- 选中日期的日程 -->
                        <ItemsControl ItemsSource="{Binding DayEvents}"
                                      ItemTemplate="{StaticResource EventItemTemplate}" />
                        <TextBlock Text="这一天没有日程"
                                   Visibility="{Binding HasSelectedDayEvents,
                                       Converter={StaticResource InvBoolToVis}}"
                                   HorizontalAlignment="Center"
                                   Margin="0,10,0,10"
                                   FontSize="12" Foreground="#66FFFFFF" />
                    </StackPanel>
                </ScrollViewer>

                <!-- 未到期事项列表 -->
                <ScrollViewer Visibility="{Binding IsCalendarView,
                                    Converter={StaticResource InvBoolToVis}}"
                              Margin="18,10,18,10"
                              VerticalScrollBarVisibility="Auto">
                    <StackPanel>
                        <DockPanel>
                            <TextBlock Text="未到期事项" FontSize="13" Foreground="#CCFFFFFF"
                                       VerticalAlignment="Center" />
                            <Button Content="＋ 新增事项" Style="{StaticResource addItemBtn}"
                                    HorizontalAlignment="Right"
                                    Padding="12,4" FontSize="11"
                                    views:ButtonRoundness.CornerRadius="6"
                                    BorderThickness="0"
                                    Command="{Binding NewItemCommand}" />
                        </DockPanel>
                        <ItemsControl ItemsSource="{Binding Items}" Margin="0,4,0,4"
                                      ItemTemplate="{StaticResource ItemListTemplate}" />
                        <TextBlock Text="暂无未到期事项"
                                   Visibility="{Binding HasItems,
                                       Converter={StaticResource InvBoolToVis}}"
                                   Margin="0,14,0,14"
                                   HorizontalAlignment="Center"
                                   FontSize="12" Foreground="#66FFFFFF" />
                    </StackPanel>
                </ScrollViewer>

            </Grid>

        </DockPanel>
    </Border>
</Window>
