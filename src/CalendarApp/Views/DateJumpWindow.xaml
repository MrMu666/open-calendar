<Window x:Class="CalendarApp.Views.DateJumpWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:CalendarApp.Views"
        Title="跳转到日期"
        Width="310" MinWidth="310"
        SizeToContent="Height"
        WindowStartupLocation="Manual"
        WindowStyle="None"
        AllowsTransparency="True"
        Background="Transparent"
        ShowInTaskbar="False"
        ShowActivated="True"
        ResizeMode="NoResize"
        Topmost="True">

    <!-- 这是独立的透明顶层窗口，不是主窗口里的 Flyout。
         只有此 Border 绘制实色，圆角之外保持透明，不会留下矩形背景。 -->
    <Border Margin="1" Padding="18,16" CornerRadius="12"
            Background="#F5F7FA"
            BorderBrush="#CBD5E1" BorderThickness="1">
        <Border.Effect>
            <DropShadowEffect BlurRadius="28" ShadowDepth="10" Direction="270"
                              Opacity="0.35" Color="#000000"/>
        </Border.Effect>
        <StackPanel>
            <StackPanel Orientation="Horizontal">
                <Path Width="15" Height="15" Stretch="Uniform" Fill="#4CAF50" VerticalAlignment="Center">
                    <Path.Data>
                        <PathGeometry Figures="M9,11H7v2h2v-2zM13,11h-2v2h2v-2zM17,11h-2v2h2v-2zM19,4h-1V2h-2v2H8V2H6v2H5c-1.11,0 -1.99,0.9 -1.99,2L3,20c0,1.1 0.89,2 2,2h14c1.1,0 2,-0.9 2,-2V6c0,-1.1 -0.9,-2 -2,-2zM19,20H5V9h14v11z" />
                    </Path.Data>
                </Path>
                <TextBlock Text="跳转到日期" FontSize="13" FontWeight="SemiBold" Foreground="#1A2333"
                           VerticalAlignment="Center" Margin="8,0,0,0"/>
            </StackPanel>

            <Grid Margin="0,10,0,0">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>
                <TextBox x:Name="YearBox" Grid.Column="0"
                         Background="#FFFFFF" Foreground="#1A2333"
                         BorderBrush="#CBD5E1" FontSize="13"
                         TextAlignment="Center" MaxLength="4"
                         Padding="6,5"
                         KeyDown="OnJumpDateKeyDown"/>
                <TextBlock Grid.Column="1" Text="年" VerticalAlignment="Center" Margin="5,0"
                           FontSize="12" Foreground="#64748B" />
                <TextBox x:Name="MonthBox" Grid.Column="2"
                         Background="#FFFFFF" Foreground="#1A2333"
                         BorderBrush="#CBD5E1" FontSize="13"
                         TextAlignment="Center" MaxLength="2"
                         Padding="6,5"
                         KeyDown="OnJumpDateKeyDown"/>
                <TextBlock Grid.Column="3" Text="月" VerticalAlignment="Center" Margin="5,0"
                           FontSize="12" Foreground="#64748B" />
                <TextBox x:Name="DayBox" Grid.Column="4"
                         Background="#FFFFFF" Foreground="#1A2333"
                         BorderBrush="#CBD5E1" FontSize="13"
                         TextAlignment="Center" MaxLength="2"
                         Padding="6,5"
                         KeyDown="OnJumpDateKeyDown"/>
                <TextBlock Grid.Column="5" Text="日" VerticalAlignment="Center" Margin="5,0"
                           FontSize="12" Foreground="#64748B" />
            </Grid>

            <Button Content="跳转" Style="{StaticResource monthJumpBtn}"
                    HorizontalAlignment="Right" Margin="0,10,0,0"
                    Padding="18,5" FontSize="12"
                    views:ButtonRoundness.CornerRadius="6"
                    BorderThickness="0"
                    Click="OnJumpDateClicked" />

            <TextBlock x:Name="JumpDateError"
                       Text="日期不合法，请检查年 / 月 / 日"
                       Foreground="#D32F2F" FontSize="11"
                       TextWrapping="Wrap" Visibility="Collapsed"
                       Margin="0,8,0,0"/>
        </StackPanel>
    </Border>
</Window>
